#include <windows.h>

101 DIALOGEX 0, 0, 270, 101
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Replace the marked range?"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", 1001, 10, 10, 250, 38
    CONTROL "&Don't ask again", 1002, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 52, 150, 12
    PUSHBUTTON "&Replace", IDOK, 139, 76, 57, 14
    DEFPUSHBUTTON "Cancel", IDCANCEL, 203, 76, 57, 14
END

102 DIALOGEX 0, 0, 270, 79
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Split Audio at Cue Points"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", 1001, 10, 10, 250, 37
    PUSHBUTTON "&Continue", IDOK, 139, 54, 57, 14
    DEFPUSHBUTTON "Cancel", IDCANCEL, 203, 54, 57, 14
END

103 DIALOGEX 0, 0, 285, 143
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About DirectCut RS"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&About DirectCut RS:", -1, 10, 9, 265, 10
    EDITTEXT 1001, 10, 21, 265, 85, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "", 1003, 10, 110, 265, 10
    PUSHBUTTON "Check for &updates", 1002, 134, 123, 82, 14
    DEFPUSHBUTTON "&Close", IDCANCEL, 220, 123, 55, 14
END

1 VERSIONINFO
FILEVERSION 1,2,1,0
PRODUCTVERSION 1,2,1,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "DirectCut RS"
            VALUE "FileVersion", "1.2.1"
            VALUE "ProductName", "DirectCut RS"
            VALUE "ProductVersion", "1.2.1"
            VALUE "OriginalFilename", "directcut-rs.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
